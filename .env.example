# =========================
# AMBIENTE
# =========================
APP_ENV=development          # development | staging | production
APP_DEBUG=True
APP_PORT=8000
APP_HOST=0.0.0.0

# =========================
# MODELO
# =========================
MODEL_PATH=app/model/model.joblib
MODEL_VERSION=1.0.0
MODEL_THRESHOLD=0.5          # threshold de classificação (ajustar conforme análise)

# =========================
# DADOS
# =========================
DATA_RAW_PATH=data/raw/
DATA_PROCESSED_PATH=data/processed/
TRAIN_TEST_SPLIT=0.2
RANDOM_STATE=42

# =========================
# TREINAMENTO
# =========================
CV_FOLDS=5
OPTIMIZE_HYPERPARAMS=True    # True para usar Optuna/GridSearch
N_TRIALS=50                  # número de trials do Optuna

# =========================
# LOGGING
# =========================
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
LOG_FILE=logs/app.log
LOG_FORMAT=json              # json | text

# =========================
# MONITORAMENTO
# =========================
DRIFT_REPORT_PATH=monitoring/reports/
DRIFT_THRESHOLD=0.1          # threshold para alertar drift

# =========================
# DOCKER / DEPLOY
# =========================
DOCKER_IMAGE_NAME=passos-magicos-ml
DOCKER_TAG=latest

# === Cloud (descomente conforme necessidade) ===
# HEROKU_APP_NAME=passos-magicos-ml
# GCP_PROJECT_ID=seu-projeto-gcp
# GCP_REGION=us-central1
# AWS_REGION=us-east-1
